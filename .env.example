# --- Supabase (server-side storage) -----------------------------------------
# Without these the app runs in read-only "live preview" mode: it reads APIMS
# directly and does not persist anything. Set all three to enable storage.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Scheduled collection ----------------------------------------------------
# Required by /api/ingest. Send as `Authorization: Bearer <secret>`.
CRON_SECRET=

# --- Gemini (optional) -------------------------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Maps use OpenFreeMap via MapLibre GL JS; no API key is required.
# Tile style is configured in lib/map.ts; attribution comes from its sources.
